# SAND — environment variables. Copy to .env (never commit .env) or set them in your host.
# Every variable is optional: SAND starts with sensible defaults and only public, keyless sources.

# --- Server -------------------------------------------------------------------
# Production port (`npm start`, default 8787). Most hosts set PORT for you.
# Leave it unset for local development: there PORT belongs to the Vite dev server.
# PORT=8787
# Development API port (`npm run dev`). Kept separate so a PORT meant for the
# Vite dev server never collides with the API.
SAND_API_PORT=8787
HOST=0.0.0.0
DATABASE_PATH=data/sand.db
# How long events stay visible/stored (hours).
RETENTION_HOURS=48
# Events sent to a browser when it connects.
SNAPSHOT_LIMIT=400
# Set to false to run the API without polling sources (tests, demos of the UI states).
INGESTION_ENABLED=true
MAX_SSE_CLIENTS=500
MAX_SSE_PER_IP=6
# Session cookies are marked Secure in production (HTTPS). Set to false only to test over plain HTTP.
# COOKIE_SECURE=true
# Only needed if the web app is served from another origin.
# CORS_ORIGIN=https://sand.example.com

# --- Sources --------------------------------------------------------------------
# Comma-separated source ids to switch off (e.g. gdelt,guardian-world).
DISABLED_SOURCES=
# Poll interval for RSS feeds, ms (default 5 min). Be gentle with publishers.
RSS_INTERVAL_MS=300000
# Replace the default RSS list (JSON array). Example with one regional feed:
# RSS_FEEDS_JSON=[{"id":"g1-sp","name":"g1 São Paulo","url":"https://g1.globo.com/rss/g1/sp/sao-paulo/","kind":"outlet","reliability":0.8,"country":"BR","language":"pt"}]

# English-language world feeds (BBC World, Guardian). Off: SAND is Brazil-only.
# ENABLE_INTERNATIONAL=1

# GDELT DOC 2.0 (no key), off by default. GDELT_ENABLED=1 turns it on.
# GDELT_ENABLED=1
# Queries separated by "||". The provider asks for ≥5 s between requests.
# GDELT_QUERIES=sourcecountry:brazil sourcelang:portuguese||(inflation OR earthquake) sourcelang:english
GDELT_TIMESPAN=30min

# NewsAPI (optional). Server-side only; never exposed to the browser.
# NEWSAPI_KEY=your-newsapi-key
# NEWSAPI_PARAMS=everything?q=Brasil&language=pt&sortBy=publishedAt&pageSize=50

# --- Optional AI enrichment (OFF by default) -----------------------------------------
# SAND runs on deterministic rules only and spends no tokens. To let Claude classify
# low-confidence articles (title + summary only; never user data), set BOTH:
LLM_ENABLED=false
# ANTHROPIC_API_KEY=your-anthropic-key
# Default model is claude-opus-5-5. For bulk classification you may prefer a cheaper
# model, e.g. claude-haiku-5-5 — your call; quality and cost differ.
LLM_MODEL=claude-opus-5-5
LLM_MAX_CALLS_PER_HOUR=120
